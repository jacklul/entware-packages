diff --git a/net/transmission/patches/020-glibc-2.27-fix-ipv6-6to4-constexpr.patch b/net/transmission/patches/020-glibc-2.27-fix-ipv6-6to4-constexpr.patch
new file mode 100644
index 0000000..da030c6
--- /dev/null
+++ b/net/transmission/patches/020-glibc-2.27-fix-ipv6-6to4-constexpr.patch
@@ -0,0 +1,11 @@
+--- a/libtransmission/net.h
++++ b/libtransmission/net.h
+@@ -392,7 +392,7 @@ struct tr_address
+     }
+
+     // 2002::/16
+-    [[nodiscard]] constexpr bool is_ipv6_6to4() const noexcept
++    [[nodiscard]] bool is_ipv6_6to4() const noexcept
+     {
+         return is_ipv6() && reinterpret_cast<uint16_t const*>(&addr.addr6)[0] == htons(0x2002U);
+     }
