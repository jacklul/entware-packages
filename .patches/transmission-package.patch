diff --git a/net/transmission/Makefile b/net/transmission/Makefile
index 976d44c..504614f 100644
--- a/net/transmission/Makefile
+++ b/net/transmission/Makefile
@@ -10,12 +10,12 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=transmission
-PKG_VERSION:=4.0.6
-PKG_RELEASE:=2
+PKG_VERSION:=4.1.3
+PKG_RELEASE:=0
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
 PKG_SOURCE_URL:=https://github.com/transmission/transmission/releases/download/$(PKG_VERSION)/
-PKG_HASH:=2a38fe6d8a23991680b691c277a335f8875bdeca2b97c6b26b598bc9c7b0c45f
+PKG_HASH:=ce7d2d8b101f7eb54bc3cf0bc55f52f7ebd4a25fa48e00bdca9a7e0fc02617da
 
 PKG_MAINTAINER:=Daniel Golle <daniel@makrotopia.org>
 PKG_LICENSE:=GPL-2.0-or-later
@@ -44,12 +44,31 @@ define Package/transmission/template
   CATEGORY:=Network
   TITLE:=BitTorrent client
   URL:=https://www.transmissionbt.com
-  DEPENDS:=+libatomic +libcurl +libdeflate +libevent2 \
+  DEPENDS:=+transmission-runtime +libcurl +libdeflate +libevent2 \
 	   +libevent2-pthreads +libminiupnpc +libnatpmp +libpthread +libpsl \
 	   +librt +libutp +zlib +LIBCURL_NOSSL:libmbedtls \
 	   +LIBCURL_GNUTLS:libmbedtls +LIBCURL_MBEDTLS:libmbedtls
 endef
 
+define Package/transmission-runtime
+  SUBMENU:=BitTorrent
+  SECTION:=net
+  CATEGORY:=Network
+  TITLE:=Private GCC runtime for Transmission 4.1+
+  URL:=https://www.transmissionbt.com
+endef
+
+define Package/transmission-runtime/description
+ Private GCC runtime libraries required by Transmission 4.1+.
+ These libraries are isolated from the system Entware GCC runtime.
+endef
+
+define Package/transmission-runtime/extra_provides
+	echo "libstdc++.so.6"; \
+	echo "libgcc_s.so.1"; \
+	echo "libatomic.so.1";
+endef
+
 define Package/transmission-daemon
   $(call Package/transmission/template)
   USERID:=transmission=224:transmission=224
@@ -96,6 +115,9 @@ define Package/transmission-daemon/conffiles
 endef
 
 TARGET_CXXFLAGS += -DHAVE_SIZE_T
+
+comma:=,
+TARGET_LDFLAGS := $(subst -Wl$(comma)-rpath=/opt/lib,-Wl$(comma)-rpath=/opt/lib/transmission-4.1,$(TARGET_LDFLAGS))
 TARGET_LDFLAGS += -latomic -Wl,--as-needed
 
 CMAKE_OPTIONS += \
@@ -130,6 +152,14 @@ CMAKE_OPTIONS += \
 	$(if $(CONFIG_LIBCURL_OPENSSL),-DWITH_CRYPTO=openssl) \
 	$(if $(CONFIG_LIBCURL_WOLFSSL),-DWITH_CRYPTO=wolfssl)
 
+define Package/transmission-runtime/install
+	$(INSTALL_DIR) $(1)/opt/lib/transmission-4.1
+	$(CP) $(TOOLCHAIN_DIR)/lib/libstdc++.so.6* $(1)/opt/lib/transmission-4.1/
+	$(RM) $(1)/opt/lib/transmission-4.1/*-gdb.py
+	$(CP) $(TOOLCHAIN_DIR)/lib/libgcc_s.so.1 $(1)/opt/lib/transmission-4.1/
+	$(CP) $(TOOLCHAIN_DIR)/lib/libatomic.so.1* $(1)/opt/lib/transmission-4.1/
+endef
+
 define Package/transmission-daemon/install
 	$(INSTALL_DIR) $(1)/opt/bin
 	$(INSTALL_BIN) $(PKG_INSTALL_DIR)/opt/bin/transmission-daemon $(1)/opt/bin/
@@ -161,6 +191,7 @@ define Package/transmission-web/install
 	$(CP) $(PKG_INSTALL_DIR)/opt/share/transmission/public_html $(1)/opt/share/transmission/
 endef
 
+$(eval $(call BuildPackage,transmission-runtime))
 $(eval $(call BuildPackage,transmission-daemon))
 $(eval $(call BuildPackage,transmission-cli))
 $(eval $(call BuildPackage,transmission-remote))
